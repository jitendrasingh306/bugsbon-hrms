# Copy this file to ".env" and edit. Never commit ".env".
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# Local MongoDB Community Server (free)
MONGODB_URI=mongodb://127.0.0.1:27017/bugsbon_hrms
# A SEPARATE database used only by automated tests (it is wiped on every test run!)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/bugsbon_hrms_test
# auto = use transactions only if MongoDB is a replica set; true = require; false = never
USE_TRANSACTIONS=auto

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Set to true only when served over HTTPS
COOKIE_SECURE=false

COMPANY_TIMEZONE=Asia/Kolkata
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Private folder for uploaded APKs and bug screenshots (relative to the server folder, or an absolute path).
# Files are never served statically; only through permission-checked download routes.
UPLOAD_DIR=storage
MAX_APK_MB=300
MAX_IMAGE_MB=5

# How expired sessions are cleaned: native (MongoDB TTL index; default), interval, disabled
SESSION_AUTO_REMOVE=native

# true = Express also serves the built React app from ../client/dist (single-port mode)
SERVE_CLIENT=false

# Optional email — OFF by default. Core features never need it.
SMTP_ENABLED=false
